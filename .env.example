# CloudPulse environment configuration.
#
# Easiest: `python scripts/init_env.py` creates .env from this file with a generated database
# password (it never overwrites an existing .env). Or copy it by hand: cp .env.example .env
# Never commit real credentials; .env is git-ignored.
#
# Which settings apply where:
#   local development   docker compose up --build            (this file's defaults)
#   automated tests     TEST_DATABASE_URL, set by you or CI (see README "Testing"); the database name
#                       must end in _test or _ci, so tests can never touch real data
#   hardened local run  docker compose -f docker-compose.yml -f docker-compose.hardened.yml up ...
#                       (same .env; the override sets same-origin API access and disables API docs)
#   public showcase     static pages only (site/); it reads no environment and holds no secrets

# --- General -----------------------------------------------------------------
# One of: local, test, development, staging, production
ENVIRONMENT=local
LOG_LEVEL=INFO
# json (default, for Docker/Azure log ingestion) or text (human-readable)
LOG_FORMAT=json

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=cloudpulse
POSTGRES_USER=cloudpulse
# Required. Use a long random value (init_env.py does this for you). To make one yourself:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(24))
#   macOS/Linux: openssl rand -base64 24
# URL-safe characters are best because the password is embedded in the database URL.
# The API refuses to start with a short or placeholder password when ENVIRONMENT is staging or
# production. The value below is only a placeholder.
POSTGRES_PASSWORD=change-me
# Host used when running the backend directly on your machine.
# Docker Compose overrides this to the "db" service name automatically.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: full SQLAlchemy URL. When set it overrides the POSTGRES_* components.
# DATABASE_URL=postgresql+psycopg://cloudpulse:change-me@127.0.0.1:5432/cloudpulse

# --- Backend -------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS. The hardened stack serves the API through the
# frontend's own origin and sets this empty.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Interactive API docs at /docs and /redoc. The hardened stack turns them off.
API_DOCS_ENABLED=true

# --- Monitoring ----------------------------------------------------------------
# Docker Compose passes all of these to both the API and the worker containers.
# Defaults are shown.

# API + worker: bounds enforced when resources are created or updated.
MONITORING_MIN_INTERVAL_SECONDS=10
MONITORING_MAX_INTERVAL_SECONDS=86400
MONITORING_DEFAULT_INTERVAL_SECONDS=60
MONITORING_DEFAULT_TIMEOUT_SECONDS=10
MONITORING_MAX_TIMEOUT_SECONDS=30
# Seconds beyond a check's timeout before a crashed check's lease is reclaimed.
MONITORING_LEASE_GRACE_SECONDS=30

# Worker only: polling cadence, concurrency ceiling, and shutdown drain time.
MONITORING_POLL_INTERVAL_SECONDS=2
MONITORING_MAX_CONCURRENT_CHECKS=10
MONITORING_SHUTDOWN_GRACE_SECONDS=20

# DEVELOPMENT ONLY. Comma-separated host or host:port entries that may resolve to
# loopback/private addresses (e.g. the demo target container). Empty = strict policy:
# all private, loopback, link-local and cloud-metadata addresses are blocked. The app
# refuses to start with a value here when ENVIRONMENT is staging or production.
# For the bundled demo target use:  demo-target:8080
MONITORING_ALLOWED_LOCAL_HOSTS=

# --- Metrics history -------------------------------------------------------------
# Every check is stored as a history row. Worker: retention. API: query limits.
# Results older than this are deleted by the worker (never by a migration).
METRICS_RETENTION_DAYS=30
# How often the worker runs cleanup (it also runs once at worker start).
METRICS_CLEANUP_INTERVAL_HOURS=24
# Rows deleted per transaction, so cleanup never holds long locks.
METRICS_CLEANUP_BATCH_SIZE=1000
# Widest allowed query window; must not exceed METRICS_RETENTION_DAYS.
METRICS_MAX_QUERY_DAYS=30
# Window used when start/end are omitted.
METRICS_DEFAULT_WINDOW_HOURS=24
# Time-series responses never contain more buckets than this.
METRICS_MAX_TIMESERIES_BUCKETS=1000
METRICS_DEFAULT_PAGE_SIZE=50
METRICS_MAX_PAGE_SIZE=200

# --- Alerting --------------------------------------------------------------------
# Every enabled rule of a resource is evaluated on each accepted check; this caps that work.
ALERTING_MAX_RULES_PER_RESOURCE=20

# --- Frontend ------------------------------------------------------------------
# API base URL as seen from the browser (not from inside Docker). It is baked into the public
# JavaScript bundle at build time, so it must never contain a secret. The hardened override builds
# the frontend with the special value `same-origin` (API calls go through the frontend's nginx).
VITE_API_URL=http://localhost:8000
# Optional build-time polling overrides (milliseconds; 0 disables), e.g. VITE_POLL_OVERVIEW_MS=30000.
# See README "Dashboard" for the full list. They apply to `npm run dev`/`npm run build`.

# --- Host port mappings for Docker Compose (change if a port is taken) ----------
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
